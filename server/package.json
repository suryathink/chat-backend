{
  "name": "chat-server",
  "version": "1.0.0",
  "description": "1:1 chat backend - MySQL (users, chats) + Firestore (messages, read receipts) + Socket.IO",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsc && node dist/scripts/runSql.js db/migrations",
    "db:seed": "tsc && node dist/scripts/runSql.js db/seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "http-status": "^2.1.0",
    "log4js": "^6.9.1",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
